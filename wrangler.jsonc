{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ekocrop-jira-release-map",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-12",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "JIRA_BASE_URL": "https://dev.ekoniva-apk.com"
  }
}
