PORT=8787

# Необязательно. На Render публичный адрес определяется автоматически.
# Для другого хостинга укажите внешний HTTPS-адрес приложения без завершающего слеша.
APP_BASE_URL=

# URL из триггера Jira Automation «Входящий веб-хук».
JIRA_AUTOMATION_WEBHOOK_URL=https://dev.ekoniva-apk.com/rest/cb-automation/latest/hooks/REPLACE_ME

# Заполняется, только если в Jira для веб-хука включён секретный токен.
JIRA_AUTOMATION_WEBHOOK_TOKEN=

# Разрешённые пользователю релизы.
RELEASES=6.0,7.0,8.0,9.0,10.0,11.0,12.0,13.0,14.0

JIRA_BASE_URL=https://dev.ekoniva-apk.com

# Проекты, из которых можно дополнительно получать сведения о версиях.
JIRA_PROJECT_KEYS=DEVELOP,PROJECTS
# Заголовок авторизации технического пользователя Jira Data Center.
# Рекомендуемый формат: Bearer <personal-access-token>
JIRA_AUTH_HEADER=Bearer REPLACE_WITH_JIRA_PAT
